## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider
.idea/
*.sln.iml

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Compiled source files
bin/
obj/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
.nuget/
*.nupkg
*.snupkg

# Local environment files
.env
.env.local

# Project files
*.csproj.user
*.vbproj.user

# Operating System files
.DS_Store
Thumbs.db

# Log files
*.log

# Node modules (if using npm)
node_modules/
npm-debug.log
